# Google Cloud
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=europe-west1
GCS_BUCKET_NAME=your-gcs-bucket
VERTEX_SERVICE_ACCOUNT=your-service-account@your-gcp-project-id.iam.gserviceaccount.com

# Secret Manager
POLYGON_API_KEY_SECRET_NAME=polygon-api-key
POLYGON_API_KEY_SECRET_VERSION=latest

# Artifact Registry / container build
ARTIFACT_REPOSITORY=mlops-images
PIPELINE_IMAGE_NAME=software-ai-pipeline

# Optional runner settings
# CODE_GCS_URI=gs://your-gcs-bucket/code
# MAIN_PY=train_lstm.py

# Pipeline execution safety: compile by default; opt in to cloud submission.
SUBMIT_PIPELINE_TO_VERTEX=false

# Optional Pub/Sub overrides
SUCCESS_TOPIC_ID=data-ingestion-success
FAILURE_TOPIC_ID=data-ingestion-failures

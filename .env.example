# Google Cloud
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=europe-west1
GCS_BUCKET_NAME=your-gcs-bucket
VERTEX_SERVICE_ACCOUNT=your-service-account@your-gcp-project-id.iam.gserviceaccount.com

# Secret Manager
